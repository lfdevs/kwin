#: effect_builtins.cpp:102
msgctxt "Name of a KWin Effect"
msgid "Blur"
msgstr "Slør"

#: effect_builtins.cpp:103
msgctxt "Comment describing the KWin Effect"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Slører bakgrunnen til delvis gjennomsiktige vinduer"

#: effect_builtins.cpp:117
msgctxt "Name of a KWin Effect"
msgid "Background contrast"
msgstr "Bakgrunnskontrast"

#: effect_builtins.cpp:118
msgctxt "Comment describing the KWin Effect"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr "Forbedre kontrast og leselighet bak delvis gjennomsiktige vinduer"

#: effect_builtins.cpp:132
msgctxt "Name of a KWin Effect"
msgid "Cover Switch"
msgstr "Omslagsbytter"

#: effect_builtins.cpp:133
msgctxt "Comment describing the KWin Effect"
msgid "Display a Cover Flow effect for the alt+tab window switcher"
msgstr "Vis omslagsflyt-effekt for alt+tab-vindusbytteren"

#: effect_builtins.cpp:147
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube"
msgstr "Skrivebordsterning"

#: effect_builtins.cpp:148
msgctxt "Comment describing the KWin Effect"
msgid "Display each virtual desktop on a side of a cube"
msgstr "Avbild virtuelle skrivebord på en terning"

#: effect_builtins.cpp:162
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube Animation"
msgstr "Animert skrivebordsterning"

#: effect_builtins.cpp:163
msgctxt "Comment describing the KWin Effect"
msgid "Animate desktop switching with a cube"
msgstr "Animer skrivebordsbytte med en terning"

#: effect_builtins.cpp:177
msgctxt "Name of a KWin Effect"
msgid "Dashboard"
msgstr "Kontrollpult"

#: effect_builtins.cpp:178
msgctxt "Comment describing the KWin Effect"
msgid "Desaturate the desktop when displaying the Plasma dashboard"
msgstr "Ton ut skrivebordet når Plasma kontrollpult vises"

#: effect_builtins.cpp:192
msgctxt "Name of a KWin Effect"
msgid "Desktop Grid"
msgstr "Skrivebordsrutenett"

#: effect_builtins.cpp:193
msgctxt "Comment describing the KWin Effect"
msgid "Zoom out so all desktops are displayed side-by-side in a grid"
msgstr "Forminsk så alle skrivebord vises side om side i et rutenett"

#: effect_builtins.cpp:207
msgctxt "Name of a KWin Effect"
msgid "Dim Inactive"
msgstr "Mørklegg inaktive"

#: effect_builtins.cpp:208
msgctxt "Comment describing the KWin Effect"
msgid "Darken inactive windows"
msgstr "Mørklegg inaktive vinduer"

#: effect_builtins.cpp:222
msgctxt "Name of a KWin Effect"
msgid "Dim Screen for Administrator Mode"
msgstr "Demp skjermen i administratormodus"

#: effect_builtins.cpp:223
msgctxt "Comment describing the KWin Effect"
msgid "Darkens the entire screen when requesting root privileges"
msgstr "Mørklegger hele skjermen når det spørres etter root-privilegier"

#: effect_builtins.cpp:237
msgctxt "Name of a KWin Effect"
msgid "Fall Apart"
msgstr "Fall fra hverandre"

#: effect_builtins.cpp:238
msgctxt "Comment describing the KWin Effect"
msgid "Closed windows fall into pieces"
msgstr "Vinduer som lukkes ramler i småbiter"

#: effect_builtins.cpp:252
msgctxt "Name of a KWin Effect"
msgid "Flip Switch"
msgstr "Bla-bytter"

#: effect_builtins.cpp:253
msgctxt "Comment describing the KWin Effect"
msgid ""
"Flip through windows that are in a stack for the alt+tab window switcher"
msgstr "Bla gjennom vinduer som ligger stablet, for alt+tab-vindusbytteren"

#: effect_builtins.cpp:267
msgctxt "Name of a KWin Effect"
msgid "Glide"
msgstr "Skyv"

#: effect_builtins.cpp:268
msgctxt "Comment describing the KWin Effect"
msgid "Windows Glide Effect as they are open and closed"
msgstr "Gjør at vinduer skyves når de åpnes og lukkes"

#: effect_builtins.cpp:282
msgctxt "Name of a KWin Effect"
msgid "Highlight Window"
msgstr "Framhev vindu"

#: effect_builtins.cpp:283
msgctxt "Comment describing the KWin Effect"
