#: main.cpp:154
#, kde-format
msgid "No Animation"
msgstr "Nincs animáció"

#: main.cpp:493
#, kde-format
msgid "No suitable Shortcut for Desktop %1 found"
msgstr "Nem található megfelelő gyorsbillentyű a(z) %1. asztalhoz"

