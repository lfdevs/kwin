msgstr "מעבר בין רשימות שולחנות עבודה (הפוך)"

#: main.cpp:112 main.cpp:146 main.cpp:511 main.cpp:512
#, kde-format
msgid "Desktop Switching"
msgstr "מעבר בין שולחנות עבודה"

#: main.cpp:124 main.cpp:491
#, kde-format
