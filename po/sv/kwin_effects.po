#: effect_builtins.cpp:101
msgctxt "Name of a KWin Effect"
msgid "Blur"
msgstr "Suddighet"

#: effect_builtins.cpp:102
msgctxt "Comment describing the KWin Effect"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Gör bakgrunden bakom halvgenomskinliga fönster suddig"

#: effect_builtins.cpp:116
msgctxt "Name of a KWin Effect"
msgid "Background contrast"
msgstr "Bakgrundskontrast"

#: effect_builtins.cpp:117
msgctxt "Comment describing the KWin Effect"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr "Förbättra kontrast och läsbarhet bakom halvgenomskinliga fönster"

#: effect_builtins.cpp:131
msgctxt "Name of a KWin Effect"
msgid "Cover Switch"
msgstr "Omslagsbyte"

#: effect_builtins.cpp:132
msgctxt "Comment describing the KWin Effect"
msgid "Display a Cover Flow effect for the alt+tab window switcher"
msgstr "Visar en flytande omslagseffekt vid fönsterbyte med Alt+Tabulator"

#: effect_builtins.cpp:146
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube"
msgstr "Skrivbordskub"

#: effect_builtins.cpp:147
msgctxt "Comment describing the KWin Effect"
msgid "Display each virtual desktop on a side of a cube"
msgstr "Visar varje virtuellt skrivbord på sidan av en kub"

#: effect_builtins.cpp:161
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube Animation"
msgstr "Animering med skrivbordskub"

#: effect_builtins.cpp:162
msgctxt "Comment describing the KWin Effect"
msgid "Animate desktop switching with a cube"
msgstr "Animera skrivbordsbyte med en kub"

#: effect_builtins.cpp:176
msgctxt "Name of a KWin Effect"
msgid "Desktop Grid"
msgstr "Skrivbordsrutnät"

#: effect_builtins.cpp:177
msgctxt "Comment describing the KWin Effect"
msgid "Zoom out so all desktops are displayed side-by-side in a grid"
msgstr "Zooma ut så att alla skrivbord visas sida vid sida i ett rutnät"

#: effect_builtins.cpp:191
msgctxt "Name of a KWin Effect"
msgid "Dim Inactive"
msgstr "Dämpa inaktiva"

#: effect_builtins.cpp:192
msgctxt "Comment describing the KWin Effect"
msgid "Darken inactive windows"
msgstr "Gör inaktiva fönster mörkare"

#: effect_builtins.cpp:206
msgctxt "Name of a KWin Effect"
msgid "Dim Screen for Administrator Mode"
msgstr "Dämpa skärmen vid administratörsläge"

#: effect_builtins.cpp:207
msgctxt "Comment describing the KWin Effect"
msgid "Darkens the entire screen when requesting root privileges"
msgstr "Gör hela skärmen mörkare när administratörsrättigheter begärs"

#: effect_builtins.cpp:221
msgctxt "Name of a KWin Effect"
msgid "Fall Apart"
msgstr "Fall sönder"

#: effect_builtins.cpp:222
msgctxt "Comment describing the KWin Effect"
msgid "Closed windows fall into pieces"
msgstr "Stängda fönster faller i bitar"

#: effect_builtins.cpp:236
msgctxt "Name of a KWin Effect"
msgid "Flip Switch"
msgstr "Blädderbyte"

#: effect_builtins.cpp:237
msgctxt "Comment describing the KWin Effect"
msgid ""
"Flip through windows that are in a stack for the alt+tab window switcher"
msgstr ""
"Bläddra igenom fönster som ligger i en hög vid fönsterbyte med Alt+Tabulator"

#: effect_builtins.cpp:251
msgctxt "Name of a KWin Effect"
msgid "Glide"
msgstr "Glid"

#: effect_builtins.cpp:252
msgctxt "Comment describing the KWin Effect"
msgid "Windows Glide Effect as they are open and closed"
msgstr "Glideffekt för fönster när de öppnas och stängs"

#: effect_builtins.cpp:266
msgctxt "Name of a KWin Effect"
msgid "Highlight Window"
msgstr "Markera fönster"

#: effect_builtins.cpp:267
msgctxt "Comment describing the KWin Effect"
msgid "Highlight the appropriate window when hovering over taskbar entries"
msgstr ""
"Markera motsvarande fönster när pekaren hålls över poster i aktivitetsfältet"

#: effect_builtins.cpp:281
msgctxt "Name of a KWin Effect"
msgid "Invert"
msgstr "Invertera"

#: effect_builtins.cpp:282
msgctxt "Comment describing the KWin Effect"
msgid "Inverts the color of the desktop and windows"
msgstr "Invertera skrivbordets och fönstrens färg"

#: effect_builtins.cpp:296
msgctxt "Name of a KWin Effect"
msgid "Kscreen"
msgstr "Kskärm"

#: effect_builtins.cpp:297
msgctxt "Comment describing the KWin Effect"
msgid "Helper Effect for KScreen"
msgstr "Hjälpeffekt för Kskärm"

#: effect_builtins.cpp:311
msgctxt "Name of a KWin Effect"
msgid "Looking Glass"
msgstr "Förstoringsglas"

#: effect_builtins.cpp:312
msgctxt "Comment describing the KWin Effect"
msgid "A screen magnifier that looks like a fisheye lens"
msgstr "Ett skärmförstoringsglas som ser ut som en fiskögonlins"

#: effect_builtins.cpp:326
msgctxt "Name of a KWin Effect"
msgid "Magic Lamp"
msgstr "Magisk lanterna"

#: effect_builtins.cpp:327
msgctxt "Comment describing the KWin Effect"
msgid "Simulate a magic lamp when minimizing windows"
msgstr "Simulera en magisk lanterna vid minimering av fönster"

#: effect_builtins.cpp:341
msgctxt "Name of a KWin Effect"
msgid "Magnifier"
msgstr "Förstoringsglas"

#: effect_builtins.cpp:342
msgctxt "Comment describing the KWin Effect"
msgid "Magnify the section of the screen that is near the mouse cursor"
msgstr "Förstorar den del av skärmen som är nära muspekaren"

