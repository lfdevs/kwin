#. i18n: ectx: property (text), widget (QLabel, label_7)
#: main.ui:36
#, kde-format
msgid ""
"To trigger an action push your mouse cursor against the edge of the screen "
"in the action's direction."
msgstr ""
"Pour déclencher une action, poussez le pointeur de votre souris contre le "
"bord de l'écran dans la direction de l'action."

