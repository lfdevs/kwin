#: effect_builtins.cpp:101
msgctxt "Name of a KWin Effect"
msgid "Blur"
msgstr "Zabriši"

#: effect_builtins.cpp:102
msgctxt "Comment describing the KWin Effect"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Zabriše ozadje za na pol prozornimi okni"

#: effect_builtins.cpp:116
msgctxt "Name of a KWin Effect"
msgid "Background contrast"
msgstr "Kontrast ozadja"

#: effect_builtins.cpp:117
msgctxt "Comment describing the KWin Effect"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr "Izboljša kontrast in berljivost za na pol prozornimi okni"

#: effect_builtins.cpp:131
msgctxt "Name of a KWin Effect"
msgid "Cover Switch"
msgstr "Preklapljanje - ovitki"

#: effect_builtins.cpp:132
msgctxt "Comment describing the KWin Effect"
msgid "Display a Cover Flow effect for the alt+tab window switcher"
msgstr ""
"Pri preklapljanju med okni z Alt+Tab prikaže učinek listanja med ovitki"

#: effect_builtins.cpp:146
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube"
msgstr "Kocka z namizji"

#: effect_builtins.cpp:147
msgctxt "Comment describing the KWin Effect"
msgid "Display each virtual desktop on a side of a cube"
msgstr "Vsako navidezno namizje prikaže na stranici kocke"

#: effect_builtins.cpp:161
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube Animation"
msgstr "Animacija kocka z namizji"

#: effect_builtins.cpp:162
msgctxt "Comment describing the KWin Effect"
msgid "Animate desktop switching with a cube"
msgstr "Animira preklapljanje med namizji s kocko"

#: effect_builtins.cpp:176
msgctxt "Name of a KWin Effect"
msgid "Desktop Grid"
msgstr "Mreža z namizji"

#: effect_builtins.cpp:177
msgctxt "Comment describing the KWin Effect"
msgid "Zoom out so all desktops are displayed side-by-side in a grid"
msgstr "Oddalji pogled, tako da so vsa namizja prikazana eno ob drugem v mreži"

#: effect_builtins.cpp:191
msgctxt "Name of a KWin Effect"
msgid "Dim Inactive"
msgstr "Potemni nedejavno"

#: effect_builtins.cpp:192
msgctxt "Comment describing the KWin Effect"
msgid "Darken inactive windows"
msgstr "Potemni nedejavna okna"

#: effect_builtins.cpp:206
msgctxt "Name of a KWin Effect"
msgid "Dim Screen for Administrator Mode"
msgstr "Potemnitev za način skrbnika"

#: effect_builtins.cpp:207
msgctxt "Comment describing the KWin Effect"
msgid "Darkens the entire screen when requesting root privileges"
msgstr "Potemni celoten zaslon, ko se zahteva skrbniška dovoljenja"

#: effect_builtins.cpp:221
msgctxt "Name of a KWin Effect"
msgid "Fall Apart"
msgstr "Razpad"

#: effect_builtins.cpp:222
msgctxt "Comment describing the KWin Effect"
msgid "Closed windows fall into pieces"
msgstr "Ko se okna zaprejo, razpadejo"

#: effect_builtins.cpp:236
msgctxt "Name of a KWin Effect"
msgid "Flip Switch"
msgstr "Preklapljanje - sklad"

#: effect_builtins.cpp:237
msgctxt "Comment describing the KWin Effect"
msgid ""
"Flip through windows that are in a stack for the alt+tab window switcher"
msgstr "Pri preklapljanju med okni z Alt+Tab se sprehajate po skladu oken"

#: effect_builtins.cpp:251
msgctxt "Name of a KWin Effect"
msgid "Glide"
msgstr "Drsenje"

#: effect_builtins.cpp:252
msgctxt "Comment describing the KWin Effect"
msgid "Windows Glide Effect as they are open and closed"
msgstr "Ko se okna odprejo zaprejo, zdrsnejo"

#: effect_builtins.cpp:266
msgctxt "Name of a KWin Effect"
msgid "Highlight Window"
msgstr "Poudari okno"

#: effect_builtins.cpp:267
msgctxt "Comment describing the KWin Effect"
msgid "Highlight the appropriate window when hovering over taskbar entries"
msgstr "Ko je kazalka nad vnosom v opravilni vrstici, poudari primerno okno"

#: effect_builtins.cpp:281
msgctxt "Name of a KWin Effect"
msgid "Invert"
msgstr "Obrni"

#: effect_builtins.cpp:282
msgctxt "Comment describing the KWin Effect"
msgid "Inverts the color of the desktop and windows"
msgstr "Obrne barve namizja in oken"

#: effect_builtins.cpp:296
msgctxt "Name of a KWin Effect"
msgid "Kscreen"
msgstr "Kscreen"

#: effect_builtins.cpp:297
msgctxt "Comment describing the KWin Effect"
msgid "Helper Effect for KScreen"
msgstr "Pomožni učinek za KScreen"

#: effect_builtins.cpp:311
msgctxt "Name of a KWin Effect"
msgid "Logout"
msgstr "Odjava"

#: effect_builtins.cpp:312
msgctxt "Comment describing the KWin Effect"
msgid "Desaturate the desktop when displaying the logout dialog"
msgstr "Ob prikazu odjavnega okna se namizju zmanjša nasičenost"

