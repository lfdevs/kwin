+void AnlandBackend::recoverRenderFailure()
+{
+    // Reimport on a fresh connection, but do not spin on unsupported buffers.
+    m_reconnectDelay = std::min(m_reconnectDelay * 2, 5000);
+    m_reconnectTimer->setInterval(m_reconnectDelay);
+    if (m_idleRendering && hasAvailableBuffer()) {
+        trigger_frame_abort(m_display);
+    }
+    request_consumer_reconnect(m_display);
+}
