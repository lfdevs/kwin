msgstr "GLX/OpenGL nisu dostupni a ugrađena je samo podrška za OpenGL."

#: compositingprefs.cpp:117
msgid "GLX/OpenGL and XRender/XFixes are not available."
msgstr "GLX/OpenGL i XRender/XFixes nisu dostupni."

