+    const auto result = m_eglLayer ? m_eglLayer->takeFrameResult() : AnlandEglLayer::FrameResult::Failed;
+    switch (result) {
+    case AnlandEglLayer::FrameResult::Rendered:
+        if (m_backend->notifyFramePresented()) {
+            m_awaitingPresent = true;
+        } else {
+            m_frame.reset();
+        }
+        break;
+    case AnlandEglLayer::FrameResult::None:
+        // No scene damage: the existing displayed content remains valid.
+        if (!m_backend->idleRendering() && m_backend->hasAvailableBuffer()) {
+            // Legacy consumers expect a response even for an unchanged buffer.
+            if (m_backend->notifyFramePresented()) {
+                m_awaitingPresent = true;
+            } else {
+                m_frame.reset();
+            }
+        } else {
+            completeFrame();
+        }
+        break;
+    case AnlandEglLayer::FrameResult::Deferred:
+        m_backend->waitForBuffer();
+        m_frame.reset();
+        break;
+    case AnlandEglLayer::FrameResult::Failed:
+        m_backend->recoverRenderFailure();
