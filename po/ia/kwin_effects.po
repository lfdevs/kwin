#: effect_builtins.cpp:102
msgctxt "Name of a KWin Effect"
msgid "Blur"
msgstr "Obscura (Blur)"

#: effect_builtins.cpp:103
msgctxt "Comment describing the KWin Effect"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Il obscura le fundo detra fenestras semi-transparente"

#: effect_builtins.cpp:117
msgctxt "Name of a KWin Effect"
msgid "Background contrast"
msgstr "Contrasto de fundo"

#: effect_builtins.cpp:118
msgctxt "Comment describing the KWin Effect"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr ""
"Meliora contrasto de fundo  e legibilitate detra fenestras semi-transparente"

#: effect_builtins.cpp:132
msgctxt "Name of a KWin Effect"
msgid "Cover Switch"
msgstr "Commutator de copertura"

#: effect_builtins.cpp:133
msgctxt "Comment describing the KWin Effect"
msgid "Display a Cover Flow effect for the alt+tab window switcher"
msgstr ""
"Monstra un effecto de fluxo de copertura pro le commutator de fenestra alt"
"+tab"

#: effect_builtins.cpp:147
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube"
msgstr "Scriptorio a Cubo"

#: effect_builtins.cpp:148
msgctxt "Comment describing the KWin Effect"
msgid "Display each virtual desktop on a side of a cube"
msgstr "Monstra cata scriptorio virtual sur un facie de un cubo"

#: effect_builtins.cpp:162
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube Animation"
msgstr "Animation de cubo de scriptorio"

#: effect_builtins.cpp:163
msgctxt "Comment describing the KWin Effect"
msgid "Animate desktop switching with a cube"
msgstr "Commuta scriptorio animate con un cubo"

#: effect_builtins.cpp:177
msgctxt "Name of a KWin Effect"
msgid "Dashboard"
msgstr "Pannello de instrumentos"

#: effect_builtins.cpp:178
msgctxt "Comment describing the KWin Effect"
msgid "Desaturate the desktop when displaying the Plasma dashboard"
msgstr ""
"De-satura le scriptorio quando il monstra le pannello de instrumentos de "
"Plasma"

#: effect_builtins.cpp:192
msgctxt "Name of a KWin Effect"
msgid "Desktop Grid"
msgstr "Grillia de scriptorio"

#: effect_builtins.cpp:193
msgctxt "Comment describing the KWin Effect"
msgid "Zoom out so all desktops are displayed side-by-side in a grid"
msgstr ""
"Face zoom retro assi que omne scriptorios es monstrate flanco a flanco in un "
"grillia"

#: effect_builtins.cpp:207
msgctxt "Name of a KWin Effect"
msgid "Dim Inactive"
msgstr "Dim Inactive"

#: effect_builtins.cpp:208
msgctxt "Comment describing the KWin Effect"
msgid "Darken inactive windows"
msgstr "Fenestras inactive obscurate"

#: effect_builtins.cpp:222
msgctxt "Name of a KWin Effect"
msgid "Dim Screen for Administrator Mode"
msgstr "Schermo Dim pro modo de administrator"

#: effect_builtins.cpp:223
msgctxt "Comment describing the KWin Effect"
msgid "Darkens the entire screen when requesting root privileges"
msgstr ""
"Il obscura le schermo integre quando il demanda privileges de super-usator "
"(root)"

#: effect_builtins.cpp:237
msgctxt "Name of a KWin Effect"
msgid "Fall Apart"
msgstr "Cade a pecias"

#: effect_builtins.cpp:238
msgctxt "Comment describing the KWin Effect"
msgid "Closed windows fall into pieces"
msgstr "Fenestras claudite cade in pecias"

#: effect_builtins.cpp:252
msgctxt "Name of a KWin Effect"
msgid "Flip Switch"
msgstr "Commutator de  colpetto (Flip)"

#: effect_builtins.cpp:253
msgctxt "Comment describing the KWin Effect"
msgid ""
"Flip through windows that are in a stack for the alt+tab window switcher"
msgstr ""
"Colpa (Flip) trans fenestras que es in le stack per le commutator de "
"fenestra alt-tab"

#: effect_builtins.cpp:267
msgctxt "Name of a KWin Effect"
msgid "Glide"
msgstr "Glissa"

#: effect_builtins.cpp:268
msgctxt "Comment describing the KWin Effect"
msgid "Windows Glide Effect as they are open and closed"
msgstr "Effectos de glissar durante que illos es aperite e claudite"

#: effect_builtins.cpp:282
msgctxt "Name of a KWin Effect"
msgid "Highlight Window"
msgstr "Evidentia fenestra"

#: effect_builtins.cpp:283
msgctxt "Comment describing the KWin Effect"
msgid "Highlight the appropriate window when hovering over taskbar entries"
msgstr ""
"Evidentia le appropriate fenestra quando il es suspendite super entratas de "
"barra de carga"

#: effect_builtins.cpp:297
msgctxt "Name of a KWin Effect"
msgid "Invert"
msgstr "Inverte"

#: effect_builtins.cpp:298
msgctxt "Comment describing the KWin Effect"
msgid "Inverts the color of the desktop and windows"
msgstr "Il inverte le colores del scriptorio e del fenestras"

#: effect_builtins.cpp:312
msgctxt "Name of a KWin Effect"
msgid "Kscreen"
msgstr "Kscreen"

#: effect_builtins.cpp:313
msgctxt "Comment describing the KWin Effect"
msgid "Helper Effect for KScreen"
msgstr "Effecto de adjutante pro KScreen"

#: effect_builtins.cpp:327
