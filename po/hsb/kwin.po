#: composite.cpp:503
#, kde-format
msgid ""
"Desktop effects have been suspended by another application.<br/>You can "
"resume using the '%1' shortcut."
msgstr ""

#: compositingprefs.cpp:99
msgid ""
"<b>OpenGL compositing (the default) has crashed KWin in the past.</"
"b><br>This was most likely due to a driver bug.<p>If you think that you have "
"meanwhile upgraded to a stable driver,<br>you can reset this protection but "
"<b>be aware that this might result in an immediate crash!</b></"
"p><p>Alternatively, you might want to use the XRender backend instead.</p>"
msgstr ""

#: compositingprefs.cpp:106
msgid "Required X extensions (XComposite and XDamage) are not available."
msgstr ""
"Trěbnej X-ekstensiji (XComposite a XDamage) njejstejitej k dispoziciji."

#: compositingprefs.cpp:110
msgid "GLX/OpenGL are not available and only OpenGL support is compiled."
msgstr ""
"GLX/OpenGL njesteji k dispoziciji a jenož podpěra za OpenGL je kompilowana."

#: compositingprefs.cpp:114
msgid "GLX/OpenGL and XRender/XFixes are not available."
msgstr "GLX/OpenGL a XRender/XFixes njestejitej k dispoziciji."

