msgstr "Den globale genvej \"%1\" er blevet tildelt skrivebord %2"

#: main.cpp:502
#, kde-format
msgid "Shortcut conflict: Could not set Shortcut %1 for Desktop %2"
msgstr "Genvejskonflikt: Kunne ikke sætte genvejen %1 til skrivebord %2"

