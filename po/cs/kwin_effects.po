#: effect_builtins.cpp:91
msgctxt "Name of a KWin Effect"
msgid "Blur"
msgstr "Rozostření"

#: effect_builtins.cpp:92
msgctxt "Comment describing the KWin Effect"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Rozostří pozadí poloprůhledných oken"

#: effect_builtins.cpp:103
msgctxt "Name of a KWin Effect"
msgid "Background contrast"
msgstr "Kontrast pozadí"

#: effect_builtins.cpp:104
msgctxt "Comment describing the KWin Effect"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr "Vylepšit kontrast a čitelnost za poloprůhlednými okny"

#: effect_builtins.cpp:115
msgctxt "Name of a KWin Effect"
msgid "Cover Switch"
msgstr "Přehlídka oken"

#: effect_builtins.cpp:116
msgctxt "Comment describing the KWin Effect"
msgid "Display a Cover Flow effect for the alt+tab window switcher"
msgstr "Zobrazuje během přepínání pomocí Alt-tab galerii oken"

#: effect_builtins.cpp:127
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube"
msgstr "Plochy na kostce"

#: effect_builtins.cpp:128
msgctxt "Comment describing the KWin Effect"
msgid "Display each virtual desktop on a side of a cube"
msgstr "Zobrazuje každou virtuální plochu jako stranu krychle"

#: effect_builtins.cpp:139
msgctxt "Name of a KWin Effect"
msgid "Desktop Cube Animation"
msgstr "Animace kostky plochy"

#: effect_builtins.cpp:140
msgctxt "Comment describing the KWin Effect"
msgid "Animate desktop switching with a cube"
msgstr "Animovat přepínání ploch pomocí kostky"

#: effect_builtins.cpp:151
msgctxt "Name of a KWin Effect"
msgid "Dashboard"
msgstr "Přístrojová deska"

#: effect_builtins.cpp:152
msgctxt "Comment describing the KWin Effect"
msgid "Desaturate the desktop when displaying the Plasma dashboard"
msgstr "Odbarvit plochu při zobrazení přístrojové desky Plasmy"

#: effect_builtins.cpp:163
msgctxt "Name of a KWin Effect"
msgid "Desktop Grid"
msgstr "Mřížka plochy"

#: effect_builtins.cpp:164
msgctxt "Comment describing the KWin Effect"
msgid "Zoom out so all desktops are displayed side-by-side in a grid"
msgstr "Oddálí plochy a zobrazí je v mřížce"

#: effect_builtins.cpp:175
msgctxt "Name of a KWin Effect"
msgid "Dim Inactive"
msgstr "Ztmavit neaktivní"

#: effect_builtins.cpp:176
msgctxt "Comment describing the KWin Effect"
msgid "Darken inactive windows"
msgstr "Ztmavit neaktivní okna"

#: effect_builtins.cpp:187
msgctxt "Name of a KWin Effect"
msgid "Dim Screen for Administrator Mode"
msgstr "Ztmavit obrazovku v administrátorském režimu"

#: effect_builtins.cpp:188
msgctxt "Comment describing the KWin Effect"
msgid "Darkens the entire screen when requesting root privileges"
msgstr ""
"Ztmaví obrazovku, pokud jsou vyžadována oprávnění administrátora systému"

