#: desktopnameswidget.cpp:67
#, kde-format
msgid "Desktop %1:"
msgstr "Työpöytä %1:"

#: desktopnameswidget.cpp:69 desktopnameswidget.cpp:70
#, kde-format
msgid "Here you can enter the name for desktop %1"
msgstr "Tässä voit antaa nimen työpöydälle %1"

#: desktopnameswidget.cpp:108 main.cpp:226
#, kde-format
msgid "Desktop %1"
msgstr "Työpöytä %1"

#: main.cpp:87
msgid ""
"<h1>Multiple Desktops</h1>In this module, you can configure how many virtual "
"desktops you want and how these should be labeled."
msgstr ""
"<h1>Monta työpöytää</h1> Tässä osiossa voit valita virtuaalityöpöytien "
"määrän ja antaa niille nimet."

#: main.cpp:99
msgid "Switch to Next Desktop"
msgstr "Vaihda seuraavaan työpöytään"

#: main.cpp:100
msgid "Switch to Previous Desktop"
msgstr "Vaihda edelliseen työpöytään"

#: main.cpp:101
msgid "Switch One Desktop to the Right"
msgstr "Vaihda yhden työpöydän verran oikealle"

#: main.cpp:102
msgid "Switch One Desktop to the Left"
msgstr "Vaihda yhden työpöydän verran vasemmalle"

#: main.cpp:103
msgid "Switch One Desktop Up"
msgstr "Vaihda yhden työpöydän verran ylös"

#: main.cpp:104
msgid "Switch One Desktop Down"
msgstr "Vaihda yhden työpöydän verran alas"

#: main.cpp:105
msgid "Walk Through Desktops"
msgstr "Selaa työpöytiä"

#: main.cpp:106
msgid "Walk Through Desktops (Reverse)"
msgstr "Selaa työpöytiä taaksepäin"

#: main.cpp:107
msgid "Walk Through Desktop List"
msgstr "Selaa työpöytäluetteloa"

#: main.cpp:108
msgid "Walk Through Desktop List (Reverse)"
msgstr "Selaa työpöytäluetteloa taaksepäin"

#: main.cpp:110 main.cpp:144 main.cpp:509 main.cpp:510
msgid "Desktop Switching"
msgstr "Työpöydän vaihto"

#: main.cpp:122 main.cpp:489
#, kde-format
msgid "Switch to Desktop %1"
msgstr "Vaihda työpöydälle %1"

#: main.cpp:154
msgid "No Animation"
msgstr "Ei animointia"

#: main.cpp:493
#, kde-format
msgid "No suitable Shortcut for Desktop %1 found"
msgstr "Työpöydälle %1 ei löytynyt sopivaa pikanäppäintä"

#: main.cpp:499
#, kde-format
msgid "Assigned global Shortcut \"%1\" to Desktop %2"
msgstr "Työpöydänlaajuinen pikanäppäin %1 liitettiin työpöytään %2"

#: main.cpp:502
#, kde-format
msgid "Shortcut conflict: Could not set Shortcut %1 for Desktop %2"
msgstr ""
"Pikanäppäinristiriita: pikanäppäimen %1 asetus työpöydälle %2 epäonnistui"

#: main.cpp:604
msgid "KWin development team"
msgstr "KWin-kehitysryhmä"

#. i18n: ectx: attribute (title), widget (QWidget, desktop)
#: main.ui:33
msgid "Desktops"
msgstr "Työpöydät"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: main.ui:39
msgid "Layout"
msgstr "Asettelu"

#. i18n: ectx: property (whatsThis), widget (QLabel, numberLabel)
#. i18n: ectx: property (whatsThis), widget (QSpinBox, numberSpinBox)
#: main.ui:51 main.ui:64
msgid ""
"Here you can set how many virtual desktops you want on your KDE desktop."
msgstr ""
"Tällä liukuvalitsimella voit määrittää, montako virtuaalityöpöytää KDE-"
"työpöydällä on käytettävissä."

#. i18n: ectx: property (text), widget (QLabel, numberLabel)
#: main.ui:54
msgid "&Number of desktops:"
msgstr "Työpöytien &määrä:"

#. i18n: ectx: property (text), widget (QLabel, label)
#: main.ui:83
msgid "N&umber of rows:"
msgstr "&Rivien määrä:"

#. i18n: ectx: property (title), widget (QGroupBox, nameGroup)
#: main.ui:103
msgid "Desktop Names"
msgstr "Työpöytien nimet"

#. i18n: ectx: attribute (title), widget (QWidget, switching)
#: main.ui:136
msgid "Switching"
msgstr "Vaihto"

#. i18n: ectx: property (whatsThis), widget (QCheckBox, wrapAroundBox)
#: main.ui:142
msgid ""
"Enable this option if you want keyboard or active desktop border navigation "
"beyond the edge of a desktop to take you to the opposite edge of the new "
"desktop."
msgstr ""
"Ota käyttöön tämä valitsin, jos haluata näppäimistön tai aktiivin "
"työpöytärajanavigoinnin työpöydän reunan ylitse vievän sinut uuden työpöydän "
"vastakkaiselle rajalle."

#. i18n: ectx: property (text), widget (QCheckBox, wrapAroundBox)
#: main.ui:145
msgid "Desktop navigation wraps around"
msgstr "Työpöytänavigointi kiertää takaisin"

# Kyse on virtuaalityöpöydän vaihtamisen animoinnista työpöytätehostetta käyttäen. Koska työpöytätehosteen maininta ei ole tässä olennainen, se on jätetty pois suomennoksesta.
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_3)
#: main.ui:152
msgid "Desktop Effect Animation"
msgstr "Animointi"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: main.ui:164
msgid "Animation:"
msgstr "Animointi:"

#. i18n: ectx: property (title), widget (QGroupBox, popupInfoCheckBox)
#: main.ui:204
msgid "Desktop Switch On-Screen Display"
msgstr "Työpöytävaihdon ruutunäyttö"

#. i18n: ectx: property (text), widget (QLabel, hideLabel)
#: main.ui:222
msgid "Duration:"
msgstr "Kesto:"

#. i18n: ectx: property (suffix), widget (QSpinBox, popupHideSpinBox)
#: main.ui:232
msgid " msec"
msgstr " ms"

#. i18n: ectx: property (toolTip), widget (QCheckBox, desktopLayoutIndicatorCheckBox)
#: main.ui:245
msgid ""
"Enabling this option will show a small preview of the desktop layout "
"indicating the selected desktop."
msgstr ""
"Tämän asetuksen käyttöönotto näyttää työpöytäasettelusta pienen esikatselun, "
"joka osoittaa valitun työpöydän."

#. i18n: ectx: property (text), widget (QCheckBox, desktopLayoutIndicatorCheckBox)
#: main.ui:248
msgid "Show desktop layout indicators"
msgstr "Näytä työpöytäasettelun osoittimet"

#. i18n: ectx: property (title), widget (QGroupBox, shortcutsGroupBox)
#: main.ui:258
msgid "Shortcuts"
msgstr "Pikanäppäimet"

#. i18n: ectx: property (text), widget (QCheckBox, allShortcutsCheckBox)
#: main.ui:277
msgid "Show shortcuts for all possible desktops"
msgstr "Näytä pikanäppäimet kaikille mahdollisille työpöydille"