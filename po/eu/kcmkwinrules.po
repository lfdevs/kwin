#: ruleswidgetbase.ui:2175
msgid "&Closeable"
msgstr "&Itxi daitekeena"

#. i18n: ectx: property (text), widget (QCheckBox, enable_type)
#: ruleswidgetbase.ui:2182
msgid "Window &type"
msgstr "Leiho &mota"

#. i18n: ectx: property (text), item, widget (KComboBox, fsplevel)
#: ruleswidgetbase.ui:2373
msgctxt "no focus stealing prevention"
msgid "None"
msgstr "Bat ere ez"

#. i18n: ectx: property (text), item, widget (KComboBox, fsplevel)
#: ruleswidgetbase.ui:2378
msgid "Low"
msgstr "Txikia"

#. i18n: ectx: property (text), item, widget (KComboBox, fsplevel)
#: ruleswidgetbase.ui:2383
msgid "Normal"
msgstr "Arrunta"

#. i18n: ectx: property (text), item, widget (KComboBox, fsplevel)
#: ruleswidgetbase.ui:2388
msgid "High"
msgstr "Altua"

#. i18n: ectx: property (text), item, widget (KComboBox, fsplevel)
#: ruleswidgetbase.ui:2393
msgid "Extreme"
msgstr "Muturrekoa"

#. i18n: ectx: property (toolTip), widget (QCheckBox, enable_fsplevel)
#: ruleswidgetbase.ui:2449
msgid ""
"KWin tries to prevent windows from taking the focus\n"
"(\"activate\") while you're working in another window,\n"
"but this may sometimes fail or superact.\n"
"\"None\" will unconditionally allow this window to get the focus while\n"
"\"Extreme\" will completely prevent it from taking the focus."
msgstr ""
"KWin saiatzen da leiho batean lanean ari zaren bitartean\n"
"beste leihoek fokua hartzea eragozten (\"aktibatu\"),\n"
"baina baliteke batzuetan huts egitea edo gehiegi jardutea.\n"
"\"Bat ere ez\" aukerarekin, leihoak baldintzarik gabe hartzen du fokua; "
"\"Muturrekoa\" aukerarekin, berriz, erabat eragozten da fokua hartzea."

#. i18n: ectx: property (text), widget (QCheckBox, enable_fsplevel)
#: ruleswidgetbase.ui:2452
msgid "&Focus stealing prevention"
msgstr "&Fokua hartzearen prebentzioa"

#. i18n: ectx: property (text), widget (QCheckBox, enable_decocolor)
#: ruleswidgetbase.ui:2459
msgid "Titlebar color &scheme"
msgstr "Titulu-barraren kolore-antolaera"